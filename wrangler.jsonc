{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "unknown-files-agent1",

  "main": "worker.js",

  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": "./"
  },

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "STORIES",
      "id": "9c38de9a91c44277adbba9584fa2c51d"
    }
  ],

  "containers": [
    {
      "class_name": "VideoContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_CONTAINER",
        "class_name": "VideoContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VideoContainer"
      ]
    }
  ]
}